# Copy to `.env` and adjust. All settings are optional — defaults live in config.py.

TERRARIUM_ENV=dev
TERRARIUM_LOG_LEVEL=INFO

TERRARIUM_API_HOST=127.0.0.1
TERRARIUM_API_PORT=8000

# Microsoft Planetary Computer. Anonymous access works; no key needed for v1.
TERRARIUM_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# OpenAQ v3, for scripts/validate_air.py only. Free and no card
# (https://explore.openaq.org/register), but v2 was retired and v3 authenticates every
# request. Without it the air core still runs — it just cannot be re-scored.
TERRARIUM_OPENAQ_KEY=

# The planner's optional LLM. **Every route works without one**: with no key `/plan`
# parses free text with a deterministic rule parser, in English and Urdu, and the DSL,
# the validators, the costs and the brief never call a model at all.
#
# Two providers because one is a single point of failure — `gemini-2.5-flash` was
# withdrawn while still listed in the model index, and 404'd for any key issued after.
# Groq is tried first; whichever is configured is used, and if both are, the second
# takes over when the first is unavailable. Both are free tier, no card.
TERRARIUM_GROQ_API_KEY=
TERRARIUM_GROQ_MODEL=llama-3.3-70b-versatile
TERRARIUM_GEMINI_API_KEY=
TERRARIUM_GEMINI_MODEL=gemini-3.6-flash
