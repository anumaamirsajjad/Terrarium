# Copy to `.env` and adjust. All settings are optional — defaults live in config.py.

TERRARIUM_ENV=dev
TERRARIUM_LOG_LEVEL=INFO

TERRARIUM_API_HOST=127.0.0.1
TERRARIUM_API_PORT=8000

# Microsoft Planetary Computer. Anonymous access works; no key needed for v1.
TERRARIUM_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# OpenAQ v3, for scripts/validate_air.py only. The one source in this project that needs
# a key: free and no card (https://explore.openaq.org/register), but v2 was retired and
# v3 authenticates every request. Without it the air core still runs — it just has not
# been scored against anything real.
TERRARIUM_OPENAQ_KEY=
